<Window x:Class="WemLabeler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WEM Labeler" Height="740" Width="1180"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu built in code for i18n -->
        <Menu x:Name="MainMenu" Grid.Row="0"/>

        <!-- 两个并列的标签页，像浏览器/Gradio 一样点击切换 -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="4,2,4,0"
                    SelectionChanged="MainTabs_SelectionChanged">

            <!-- ===================== 标签页 1：标注音频 ===================== -->
            <TabItem x:Name="LabelTab">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="280"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="5*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: File List -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#2d2d2d" Padding="4" BorderBrush="#555" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="WemID:" VerticalAlignment="Center"
                                           Foreground="#CCC" Margin="4,0,6,0" FontSize="12"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         FontSize="12" Padding="2,1"
                                         TextChanged="SearchBox_TextChanged"
                                         KeyDown="SearchBox_KeyDown"/>
                                <Button x:Name="SearchClearButton" Grid.Column="2"
                                        Content="✕" Width="22" Height="22" Margin="4,0,0,0"
                                        FontSize="11" Click="SearchClearButton_Click"
                                        IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <ListView x:Name="FileListView"
                              Grid.Row="1"
                              MouseDoubleClick="FileListView_MouseDoubleClick"
                              SelectionChanged="FileListView_SelectionChanged"
                              GridViewColumnHeader.Click="FileListView_ColumnHeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusMark}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="WemID" Width="105" DisplayMemberBinding="{Binding WemID}"/>
                                    <GridViewColumn Header="Filename" Width="125" DisplayMemberBinding="{Binding Filename}"/>
                                    <GridViewColumn Header="Label" Width="200" DisplayMemberBinding="{Binding DisplayLabel}"/>
                                    <GridViewColumn Header="Duration" Width="110" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                    <GridViewColumn Header="Channels" Width="90" DisplayMemberBinding="{Binding ChannelConfig}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLabel}" Value="True">
                                            <Setter Property="Background" Value="#C8FFC8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCC"/>

                    <!-- Right Panel -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>

                            <!-- File Info -->
                            <GroupBox x:Name="FileInfoGroup" Margin="0,0,0,10">
                                <StackPanel Margin="8">
                                    <TextBlock x:Name="InfoFilename" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="InfoWemID" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="InfoChannel" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="InfoPath" TextTrimming="CharacterEllipsis"
                                               Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Source Info -->
                            <GroupBox x:Name="SourceInfoGroup" Margin="0,0,0,10">
                                <StackPanel Margin="8">
                                    <TextBlock x:Name="InfoWemRes" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="InfoBanks" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="InfoTxtp" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="InfoWwiseID"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Playback -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="PlayButton" Width="70" Height="28"
                                        IsEnabled="False" Click="PlayButton_Click"/>
                                <Button x:Name="StopButton" Width="70" Height="28" Margin="8,0,0,0"
                                        IsEnabled="False" Click="StopButton_Click"/>
                                <Button x:Name="PlayOwnerTxtpButton" Width="130" Height="28" Margin="8,0,0,0"
                                        IsEnabled="False" Click="PlayOwnerTxtpButton_Click"/>
                                <CheckBox x:Name="AutoPlayCheck"
                                          Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Waveform -->
                            <Border Margin="0,0,0,10" Height="85"
                                    MouseLeftButtonDown="WaveformBorder_MouseDown">
                                <Grid Background="#1a1a2e">
                                    <Canvas x:Name="WaveformCanvas" Height="80"
                                            SizeChanged="WaveformCanvas_SizeChanged"/>
                                    <TextBlock x:Name="WaveformTimeLabel" Foreground="#888"
                                               FontSize="10" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Margin="0,0,6,4"/>
                                </Grid>
                            </Border>

                            <!-- Label input -->
                            <TextBlock x:Name="LabelHint" Margin="0,0,0,4"/>
                            <TextBox x:Name="LabelTextBox" Height="28" IsEnabled="False"
                                     TextChanged="LabelTextBox_TextChanged" KeyDown="LabelTextBox_KeyDown"/>

                            <!-- Actions row -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SaveButton" Width="90" Height="30"
                                        IsEnabled="False" Click="SaveButton_Click"/>
                                <Button x:Name="PrevButton" Width="110" Height="30"
                                        IsEnabled="False" Margin="12,0,0,0" Click="PrevButton_Click"/>
                                <Button x:Name="NextButton" Width="110" Height="30"
                                        IsEnabled="False" Margin="4,0,0,0" Click="NextButton_Click"/>
                                <Button x:Name="ExportWavCoordButton" Width="90" Height="30"
                                        IsEnabled="False" Margin="12,0,0,0" Click="ExportWavCoordButton_Click"/>
                                <Button x:Name="ExportTracksButton" Width="90" Height="30"
                                        IsEnabled="False" Margin="8,0,0,0" Click="ExportTracksButton_Click"/>
                            </StackPanel>

                            <!-- Progress -->
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock x:Name="ProgressLabel"/>
                                <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,4,0,0"
                                             Minimum="0" Maximum="1" Value="0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== 标签页 2：提取音频 ===================== -->
            <TabItem x:Name="ExtractTab">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 路径设置（Gradio 风格的输入框） -->
                    <GroupBox x:Name="PathsGroup" Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PathBaseDirLabel" Grid.Row="0" Grid.Column="0"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="PathBaseDirBox" Grid.Row="0" Grid.Column="1"
                                     Margin="0,0,6,4" Padding="3,2" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseBaseDir" Grid.Row="0" Grid.Column="2"
                                    Width="76" Margin="0,0,6,4" Click="BtnBrowseBaseDir_Click"/>
                            <Button x:Name="BtnOpenBaseDir" Grid.Row="0" Grid.Column="3"
                                    Width="76" Margin="0,0,0,4" Click="BtnOpenBaseDir_Click"/>

                            <TextBlock x:Name="PathOutputDirLabel" Grid.Row="1" Grid.Column="0"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="PathOutputDirBox" Grid.Row="1" Grid.Column="1"
                                     Margin="0,0,6,4" Padding="3,2" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseOutputDir" Grid.Row="1" Grid.Column="2"
                                    Width="76" Margin="0,0,6,4" Click="BtnBrowseOutputDir_Click"/>
                            <Button x:Name="BtnOpenOutputDir" Grid.Row="1" Grid.Column="3"
                                    Width="76" Margin="0,0,0,4" Click="BtnOpenOutputDir_Click"/>

                            <TextBlock x:Name="PathWemResWemLabel" Grid.Row="2" Grid.Column="0"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="PathWemResWemDirBox" Grid.Row="2" Grid.Column="1"
                                     Margin="0,0,6,4" Padding="3,2" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseWemResWemDir" Grid.Row="2" Grid.Column="2"
                                    Width="76" Margin="0,0,6,4" Click="BtnBrowseWemResWemDir_Click"/>
                            <Button x:Name="BtnOpenWemResWemDir" Grid.Row="2" Grid.Column="3"
                                    Width="76" Margin="0,0,0,4" Click="BtnOpenWemResWemDir_Click"/>

                            <TextBlock x:Name="PathTxtpDirLabel" Grid.Row="3" Grid.Column="0"
                                       VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="PathTxtpDirBox" Grid.Row="3" Grid.Column="1"
                                     Margin="0,0,6,4" Padding="3,2" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseTxtpDir" Grid.Row="3" Grid.Column="2"
                                    Width="76" Margin="0,0,6,4" Click="BtnBrowseTxtpDir_Click"/>
                            <Button x:Name="BtnOpenTxtpDir" Grid.Row="3" Grid.Column="3"
                                    Width="76" Margin="0,0,0,4" Click="BtnOpenTxtpDir_Click"/>

                            <TextBlock x:Name="PathVgmstreamLabel" Grid.Row="4" Grid.Column="0"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="PathVgmstreamBox" Grid.Row="4" Grid.Column="1"
                                     Margin="0,0,6,0" Padding="3,2" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseVgmstream" Grid.Row="4" Grid.Column="2"
                                    Width="76" Margin="0,0,6,0" Click="BtnBrowseVgmstream_Click"/>
                            <Button x:Name="BtnResetPaths" Grid.Row="4" Grid.Column="3"
                                    Width="76" Click="BtnResetPaths_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- 操作按钮 -->
                    <GroupBox x:Name="ActionsGroup" Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel Margin="8">
                            <WrapPanel>
                                <Button x:Name="BtnExtractBanks" MinWidth="200" Height="34"
                                        Margin="0,0,8,8" Click="BtnExtractBanks_Click"/>
                                <Button x:Name="BtnBuildMapping" MinWidth="180" Height="34"
                                        Margin="0,0,8,8" Click="BtnBuildMapping_Click"/>
                                <Button x:Name="BtnExportAudio" MinWidth="180" Height="34"
                                        Margin="0,0,8,8" Click="BtnExportAudio_Click"/>
                                <Button x:Name="BtnBuildAndExport" MinWidth="210" Height="34"
                                        Margin="0,0,8,8" Click="BtnBuildAndExport_Click"/>
                                <Button x:Name="BtnUnusedWem" MinWidth="180" Height="34"
                                        Margin="0,0,8,8" Click="BtnUnusedWem_Click"/>
                                <Button x:Name="BtnRebuildTxtpIndex" MinWidth="150" Height="34"
                                        Margin="0,0,8,8" Click="BtnRebuildTxtpIndex_Click"/>
                            </WrapPanel>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="EventIdsLabel" Grid.Column="0" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBox x:Name="EventIdsBox" Grid.Column="1" Padding="3,2"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnExportById" Grid.Column="2" Width="130" Height="30"
                                        Margin="8,0,0,0" Click="BtnExportById_Click"/>
                                <CheckBox x:Name="ChkForceWemCache" Grid.Column="3"
                                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 输出日志 -->
                    <GroupBox x:Name="OutputGroup" Grid.Row="2">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ExtractRunStatus" Grid.Row="0" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1">
                                <TextBox x:Name="ExtractLogBox" IsReadOnly="True" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="11"
                                         TextWrapping="NoWrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ExtractProgress" Grid.Column="0" Height="18"
                                             VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0"/>
                                <Button x:Name="BtnCopyExtractLog" Grid.Column="1" Width="100" Height="28"
                                        Margin="8,0,0,0" Click="BtnCopyExtractLog_Click"/>
                                <Button x:Name="BtnClearExtractLog" Grid.Column="2" Width="100" Height="28"
                                        Margin="8,0,0,0" Click="BtnClearExtractLog_Click"/>
                                <Button x:Name="BtnCancelJob" Grid.Column="3" Width="100" Height="28"
                                        Margin="8,0,0,0" IsEnabled="False" Click="BtnCancelJob_Click"/>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="StatusProgress" Width="120" Height="14"
                             IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
