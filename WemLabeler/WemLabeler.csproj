<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- OdradekSharp 是独立 CLI（OutputType=Exe），这里只引用它的 DLL。
         用 RID 发布（CI 里的 win-x64）时，SDK 的 ValidateExecutableReferences 会认为
         「被引用的可执行文件是自包含的、而本项目不是」并报 NETSDK1151。
         两边其实都是框架依赖（SelfContained=false），只是 RID 让检查误判，所以关掉该校验。
         这是 SDK 自带的开关（见 Microsoft.NET.Sdk.targets 的 ValidateExecutableReferences 目标）。 -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接读取游戏文件的 Decima/DS2 读取器（另一个 agent 移植，实测导出结果与 odradek 逐字节相同） -->
    <ProjectReference Include="..\OdradekSharp\OdradekSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RTTI 定义随 exe 一起分发；DecimaGame.Open 默认在 AppContext.BaseDirectory\Data 下找 -->
    <Content Include="..\OdradekSharp\Data\types.json" Link="Data\types.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\OdradekSharp\Data\extensions.json" Link="Data\extensions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- wwiser 的 CLI 启动脚本：embed 版 Python 没有 tkinter，而 wwiser.pyz 的 __main__
         会无条件 import wwiser.wgui，所以必须走这个脚本（见文件头注释）。 -->
    <None Update="utils\wwiser_cli.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

</Project>
